# ---- Telegram (tu consola conmigo) ----
# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Tu user id numerico. Preguntaselo a @userinfobot. NADIE mas puede usar el bot.
TELEGRAM_OWNER_ID=123456789

# ---- Daemon de WhatsApp ----
HERMES_WA_PORT=8787
# Secreto compartido entre el daemon, el MCP server y el bridge. Invéntate uno largo.
HERMES_TOKEN=cambia-esto-por-algo-largo-y-aleatorio
# direct  = manda el WhatsApp de inmediato
# approve = te manda el borrador a Telegram y solo envia si le das "Enviar"
WA_SEND_MODE=approve
# Lada de pais por default para numeros de 10 digitos (52 = Mexico)
WA_DEFAULT_CC=52

# ---- Agente ----
# Carpeta donde el agente puede leer/escribir archivos (notas, adjuntos, etc.)
HERMES_WORKSPACE=/home/angel/hermes-workspace
ANTHROPIC_API_KEY=
