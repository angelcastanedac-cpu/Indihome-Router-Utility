<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: copia a ~/Library/LaunchAgents/ y ajusta las rutas.
     Cargar:  launchctl load -w ~/Library/LaunchAgents/com.hermes.bridge.plist
     Detener: launchctl unload ~/Library/LaunchAgents/com.hermes.bridge.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/angel/hermes/hermes/src/telegram/bridge.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/angel/hermes/hermes</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/angel/hermes/hermes/bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/angel/hermes/hermes/bridge.log</string>
</dict>
</plist>
